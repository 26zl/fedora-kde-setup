[Unit]
Description=USB autosuspend for xHCI-blocking devices
# Apply device-specific power settings after drivers finish coldplug overrides.

[Service]
Type=oneshot
ExecStartPre=-/usr/bin/udevadm settle --timeout=10
ExecStart=/bin/bash -c '\
  for dev in /sys/bus/usb/devices/*/; do \
    vid=$(cat "$dev/idVendor" 2>/dev/null); \
    pid=$(cat "$dev/idProduct" 2>/dev/null); \
    case "$vid:$pid" in \
      0951:176b|03f0:098d) \
        echo auto > "$dev/power/control" 2>/dev/null;; \
    esac; \
  done'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
