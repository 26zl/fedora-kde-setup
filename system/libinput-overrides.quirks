# Disable debouncing only for LAMZU and Compx USB mice with non-bouncing switches.
[LAMZU Compx dongles]
MatchUdevType=mouse
MatchBus=usb
MatchVendor=0x3554
ModelBouncingKeys=1

[LAMZU Maya X]
MatchUdevType=mouse
MatchBus=usb
MatchVendor=0x373E
ModelBouncingKeys=1

[LAMZU INCA and PARO]
MatchUdevType=mouse
MatchBus=usb
MatchVendor=0x37B0
ModelBouncingKeys=1
