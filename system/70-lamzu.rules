# uaccess grants the logged-in (seat) user ACL access — no input group membership needed

# LAMZU Maya - 8K Dongle
SUBSYSTEM=="input", ATTRS{id/vendor}=="3554", ATTRS{name}=="Compx LAMZU 8K Dongle", TAG+="uaccess"
SUBSYSTEM=="input", ATTRS{name}=="Compx LAMZU 8K Dongle Consumer Control", TAG+="uaccess"
SUBSYSTEM=="input", ATTRS{name}=="Compx LAMZU 8K Dongle System Control", TAG+="uaccess"
SUBSYSTEM=="input", ATTRS{name}=="Compx LAMZU 8K Dongle Mouse", TAG+="uaccess"

# LAMZU Maya - Direct Device (wired)
SUBSYSTEM=="input", ATTRS{id/vendor}=="3554", ATTRS{name}=="compx LAMZU Maya Champion", TAG+="uaccess"
SUBSYSTEM=="input", ATTRS{name}=="compx LAMZU Maya Champion Consumer Control", TAG+="uaccess"
SUBSYSTEM=="input", ATTRS{name}=="compx LAMZU Maya Champion System Control", TAG+="uaccess"
SUBSYSTEM=="input", ATTRS{name}=="compx LAMZU Maya Champion Keyboard", TAG+="uaccess"

# LAMZU Maya USB device rules for both dongle and wired modes
SUBSYSTEM=="usb", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="f510", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="f50f", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="f510", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="f50f", TAG+="uaccess"

