SUBSYSTEM=="input", ATTRS{name}=="LAMZU LAMZU MAYA X Keyboard", TAG+="uaccess"

# USB device rules for both dongle and mouse
SUBSYSTEM=="usb", ATTRS{idVendor}=="373e", ATTRS{idProduct}=="001e", TAG+="uaccess"
